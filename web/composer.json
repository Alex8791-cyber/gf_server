{
    "name": "gfserver/web-backend",
    "description": "Account and admin backend for the gf_server private server.",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-pdo_pgsql": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11"
    },
    "autoload": {
        "psr-4": {
            "GfServer\\": "lib/",
            "GfServer\\App\\": "app/"
        },
        "files": [ "app/helpers.php" ]
    },
    "autoload-dev": {
        "psr-4": { "GfServer\\Tests\\": "tests/" }
    },
    "config": {
        "sort-packages": true
    }
}
